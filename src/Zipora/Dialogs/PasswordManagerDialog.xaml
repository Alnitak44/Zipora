<ui:FluentWindow x:Class="Zipora.Dialogs.PasswordManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="密码管理" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ZiporaWindowSurface}" WindowCornerPreference="Round"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="密码管理" ShowMaximize="False" ShowMinimize="False" FontSize="16" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="常用密码" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CountText" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="NewPasswordBox" Grid.Column="0" PlaceholderText="输入要保存的密码"/>
                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource DialogPrimaryButton}" Content="添加" Click="AddButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="已保存密码" FontWeight="SemiBold"/>
                    <ListBox x:Name="PasswordList" Style="{StaticResource SurfaceListBox}" Height="180" Margin="0,10,0,0" DisplayMemberPath="Value"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <ui:Button Content="删除选中" Style="{StaticResource DialogSecondaryButton}" Click="DeleteButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" Margin="2,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="ImportLocalButton" Visibility="Collapsed" Content="导入本机密码" Click="ImportLocal_Click" Style="{StaticResource DialogSecondaryButton}"/>
                <ui:Button x:Name="LockVaultButton" Visibility="Collapsed" Content="锁定" Click="LockVault_Click" Style="{StaticResource DialogSecondaryButton}"/>
                <ui:Button Content="关闭" Style="{StaticResource DialogSecondaryButton}" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
