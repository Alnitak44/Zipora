<ui:FluentWindow x:Class="Zipora.Dialogs.ArchiveDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="压缩包详细信息" Icon="pack://application:,,,/Zipora;component/Assets/Zipora.png"
        Width="520" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ZiporaWindowSurface}"
        WindowCornerPreference="Round"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <Grid Margin="16">
        <Grid.Resources>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,14,0,5"/>
                <Setter Property="Foreground" Value="{DynamicResource ZiporaTextSecondary}"/>
            </Style>
            <Style x:Key="ValueText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ZiporaTextPrimary}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="详细信息" ShowMaximize="False" ShowMinimize="False"
                     FontSize="16" FontWeight="SemiBold"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,18" Margin="0,8,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="42" Height="42" CornerRadius="10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Archive20" FontSize="23"
                                           Foreground="{DynamicResource ZiporaAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="ArchiveNameText" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>

                    <Separator/>

                    <TextBlock Text="基本信息" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="大小" Foreground="{DynamicResource ZiporaTextSecondary}"/><TextBlock x:Name="SizeText" Grid.Column="1" Style="{StaticResource ValueText}"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="文件" Foreground="{DynamicResource ZiporaTextSecondary}"/><TextBlock x:Name="FileCountText" Grid.Column="1" Style="{StaticResource ValueText}"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="文件夹" Foreground="{DynamicResource ZiporaTextSecondary}"/><TextBlock x:Name="FolderCountText" Grid.Column="1" Style="{StaticResource ValueText}"/></Grid>

                    <TextBlock Text="压缩信息" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="格式" Foreground="{DynamicResource ZiporaTextSecondary}"/><TextBlock x:Name="FormatText" Grid.Column="1" Style="{StaticResource ValueText}"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="算法" Foreground="{DynamicResource ZiporaTextSecondary}"/><TextBlock x:Name="MethodText" Grid.Column="1" Style="{StaticResource ValueText}"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="压缩率" Foreground="{DynamicResource ZiporaTextSecondary}"/><TextBlock x:Name="RatioText" Grid.Column="1" Style="{StaticResource ValueText}"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="加密" Foreground="{DynamicResource ZiporaTextSecondary}"/><TextBlock x:Name="EncryptionText" Grid.Column="1" Style="{StaticResource ValueText}"/></Grid>

                    <TextBlock Text="结构" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="分卷" Foreground="{DynamicResource ZiporaTextSecondary}"/><TextBlock x:Name="VolumesText" Grid.Column="1" Style="{StaticResource ValueText}"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="固实压缩" Foreground="{DynamicResource ZiporaTextSecondary}"/><TextBlock x:Name="SolidText" Grid.Column="1" Style="{StaticResource ValueText}"/></Grid>

                    <TextBlock Text="安全" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="CRC校验" Foreground="{DynamicResource ZiporaTextSecondary}"/><TextBlock x:Name="CrcText" Grid.Column="1" Style="{StaticResource ValueText}"/></Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="SHA256" Foreground="{DynamicResource ZiporaTextSecondary}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <ui:Button x:Name="ComputeSha256Button" Appearance="Transparent" Padding="0,2"
                                       HorizontalAlignment="Left" Click="ComputeSha256_Click" Content="[计算]"/>
                            <TextBlock x:Name="Sha256Text" Visibility="Collapsed" TextWrapping="Wrap"
                                       FontFamily="Consolas" FontSize="11" LineHeight="16"
                                       Foreground="{DynamicResource ZiporaTextSecondary}"/>
                            <ProgressBar x:Name="Sha256Progress" Height="3" Margin="0,5,0,0"
                                         Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="内容分析" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="图片" Foreground="{DynamicResource ZiporaTextSecondary}"/><TextBlock x:Name="ImageCountText" Grid.Column="1" Style="{StaticResource ValueText}"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="视频" Foreground="{DynamicResource ZiporaTextSecondary}"/><TextBlock x:Name="VideoCountText" Grid.Column="1" Style="{StaticResource ValueText}"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="程序" Foreground="{DynamicResource ZiporaTextSecondary}"/><TextBlock x:Name="ProgramCountText" Grid.Column="1" Style="{StaticResource ValueText}"/></Grid>

                    <ui:Button Content="关闭" IsCancel="True" HorizontalAlignment="Right"
                               Margin="0,18,0,0" Style="{StaticResource DialogSecondaryButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</ui:FluentWindow>
