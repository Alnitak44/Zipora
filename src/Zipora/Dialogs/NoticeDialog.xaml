<ui:FluentWindow x:Class="Zipora.Dialogs.NoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Zipora" Icon="pack://application:,,,/Assets/Zipora.png"
        Width="440" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ZiporaWindowSurface}"
        WindowCornerPreference="Round"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" x:Name="DialogTitle" Title="Zipora" ShowMaximize="False" ShowMinimize="False"
                     FontSize="16" FontWeight="SemiBold"/>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22" Margin="0,8,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            Margin="0,0,14,0">
                        <ui:SymbolIcon x:Name="NoticeIcon" Symbol="Info20" FontSize="24" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="HeadlineText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock x:Name="MessageText" Margin="56,12,0,18" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{DynamicResource ZiporaTextSecondary}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ui:Button x:Name="SecondaryButton" Grid.Column="1" Appearance="Secondary" Margin="0,0,8,0"
                               Click="Secondary_Click" Visibility="Collapsed"/>
                    <ui:Button x:Name="PrimaryButton" Grid.Column="2" Appearance="Primary" Click="Primary_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
