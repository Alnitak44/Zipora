<ui:FluentWindow x:Class="Zipora.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="需要密码"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ZiporaWindowSurface}"
        WindowCornerPreference="Round"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="需要密码" ShowMaximize="False" ShowMinimize="False"
                     FontSize="16" FontWeight="SemiBold"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,8,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:SymbolIcon Symbol="LockClosed20" FontSize="20" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    <TextBlock x:Name="ArchiveNameText" FontWeight="SemiBold" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="InfoText" TextWrapping="Wrap" Margin="0,4,0,12"
                           Style="{StaticResource SecondaryText}"/>

                <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
                <Grid x:Name="PasswordInputGrid" Margin="0,0,0,12">
                    <ui:PasswordBox x:Name="PasswordBox" Padding="34,0,34,0"/>
                    <Button x:Name="SavedPasswordButton" Width="16" Height="16"
                            Padding="0" Focusable="False"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"
                            ToolTip="展开常用密码" Click="ToggleSavedPasswords_Click" Panel.ZIndex="1">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Surface" Background="Transparent" CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ZiporaHoverBackground}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Surface" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <ui:SymbolIcon Symbol="ChevronUp20" FontSize="12"/>
                    </Button>
                    <Popup x:Name="SavedPasswordPopup" Placement="Top" PlacementTarget="{Binding ElementName=PasswordInputGrid}"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Style="{StaticResource FlyoutCard}" Padding="8" MinWidth="240" MaxHeight="180">
                            <ListBox x:Name="SavedPasswordList" Style="{StaticResource SurfaceListBox}" SelectionChanged="SavedPasswordList_SelectionChanged"/>
                        </Border>
                    </Popup>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="CloudButton" Style="{StaticResource DialogSecondaryButton}"
                               Click="CloudButton_Click" Content="云端查询"/>
                    <ui:Button x:Name="CrackButton" Style="{StaticResource DialogSecondaryButton}"
                               Click="CrackButton_Click" Content="字典破解"/>
                    <ui:Button Content="取消" Style="{StaticResource DialogSecondaryButton}" IsCancel="True"/>
                    <ui:Button Content="确定" Style="{StaticResource DialogPrimaryButton}"
                               Click="OkButton_Click" IsDefault="True"/>
                </StackPanel>

                <Border x:Name="StatusPanel" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="6" Padding="10,7" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing x:Name="StatusSpinner" IsIndeterminate="True" Width="14" Height="14"
                                         Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
