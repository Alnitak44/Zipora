<ui:FluentWindow x:Class="Zipora.Dialogs.PortableVaultDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="便携密码库" Width="460" SizeToContent="Height" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True"
    Background="{DynamicResource ZiporaWindowSurface}" FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="16">
        <ui:TitleBar Title="便携密码库" ShowMaximize="False" ShowMinimize="False" FontSize="16" FontWeight="SemiBold"/>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,8,0,12">
            <StackPanel>
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"/>
                <TextBlock Text="主密码" Margin="0,14,0,6"/>
                <ui:PasswordBox x:Name="MasterBox" MaxLength="1024"/>
                <StackPanel x:Name="ConfirmPanel" Margin="0,12,0,0">
                    <TextBlock Text="确认主密码" Margin="0,0,0,6"/>
                    <ui:PasswordBox x:Name="ConfirmBox" MaxLength="1024"/>
                </StackPanel>
                <TextBlock Text="主密码不会保存在 U 盘。关闭程序后需要重新解锁；忘记主密码将无法找回库内密码。请勿在不可信的电脑上解锁。"
                    TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource ZiporaWarningBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="取消" IsCancel="True" Style="{StaticResource DialogSecondaryButton}"/>
            <ui:Button x:Name="UnlockButton" Content="解锁" IsDefault="True" Style="{StaticResource DialogPrimaryButton}" Click="Unlock_Click"/>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
