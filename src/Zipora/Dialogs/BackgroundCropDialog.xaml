<ui:FluentWindow x:Class="Zipora.Dialogs.BackgroundCropDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="裁切背景图片" Width="650" Height="590" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True"
 Background="{DynamicResource ZiporaWindowSurface}" Foreground="{DynamicResource ZiporaTextPrimary}">
 <StackPanel Margin="20,8,20,16">
  <ui:TitleBar Title="裁切背景图片" ShowMinimize="False" ShowMaximize="False"/>
  <TextBlock Text="拖动图片调整位置，用滑块缩放。固定 3:2 区域将作为窗口背景。" TextWrapping="Wrap" Margin="0,8,0,12"/>
  <Border Width="600" Height="400" BorderBrush="{DynamicResource ZiporaAccentBrush}" BorderThickness="1" HorizontalAlignment="Center">
   <Canvas x:Name="Viewport" Width="598" Height="398.6666667" ClipToBounds="True" Background="#202020" Cursor="SizeAll"
    MouseLeftButtonDown="StartDrag" MouseMove="Drag" MouseLeftButtonUp="EndDrag">
    <Image x:Name="Preview" Stretch="Fill" IsHitTestVisible="False"/>
   </Canvas>
  </Border>
  <Grid Margin="0,14,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="缩放" VerticalAlignment="Center" Margin="0,0,10,0"/>
   <Slider Grid.Column="1" Minimum="1" Maximum="4" Value="1" Width="230" HorizontalAlignment="Left" VerticalAlignment="Center" ValueChanged="ZoomChanged"/>
   <ui:Button Grid.Column="2" Content="取消" IsCancel="True" Margin="12,0,8,0"/>
   <ui:Button Grid.Column="3" Content="使用裁切" Appearance="Primary" Click="Accept"/>
  </Grid>
 </StackPanel>
</ui:FluentWindow>
