<ui:FluentWindow x:Class="Zipora.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:behaviors="clr-namespace:Zipora.Behaviors"
        Title="设置"
        Width="680" Height="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ZiporaWindowSurface}"
        WindowCornerPreference="Round"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="126"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="3" Title="设置" ShowMaximize="False" ShowMinimize="False"
                     FontSize="16" FontWeight="SemiBold"/>

        <!-- 目录：用于快速定位设置分区，后续可继续补充锚点。 -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,14,0" VerticalAlignment="Top">
            <StackPanel.Resources>
                <!-- 不使用 WPF-UI 的按钮模板：其不同交互状态会改变外部留白，
                     导致目录项看上去不在同一条竖线上。 -->
                <Style x:Key="SettingsTocButton" TargetType="Button">
                    <Setter Property="Width" Value="110"/>
                    <Setter Property="Height" Value="34"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="Foreground" Value="{DynamicResource ZiporaTextPrimary}"/>
                    <Setter Property="Background" Value="{DynamicResource ZiporaCardBackground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ZiporaCardBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ZiporaHoverBackground}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ZiporaRowSelectedFill}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>
            <Button Content="主题" Style="{StaticResource SettingsTocButton}" Click="NavigateToTheme_Click"/>
            <Button Content="功能" Style="{StaticResource SettingsTocButton}" Margin="0,6,0,0"
                    Click="NavigateToFunction_Click"/>
        </StackPanel>
        <Border Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                Background="{DynamicResource ZiporaCardBorder}"/>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Grid.Column="2" Margin="14,8,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0"
                      behaviors:AutoHideScrollBars.Enabled="True">
        <StackPanel>

            <Border x:Name="PortableInfoCard" Visibility="Collapsed" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="U 盘便携模式" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PortableInfoText" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" FontSize="12"/>
                </StackPanel>
            </Border>
            <!-- 主题分类 -->
            <Grid x:Name="ThemeSection" Margin="2,0,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ColorBackground20" FontSize="17" Margin="0,0,7,0"
                                   Foreground="{DynamicResource ZiporaAccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="主题" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="1" Height="1" Margin="14,0,0,0"
                        Background="{DynamicResource ZiporaCardBorder}" VerticalAlignment="Center"/>
            </Grid>

            <!-- 外观主题卡片 -->
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ColorBackground20" FontSize="17" Margin="0,0,7,0"
                                       Foreground="{DynamicResource ZiporaTextSecondary}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="外观主题" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="1,12,0,0">
                        <RadioButton x:Name="LightThemeRadio" Content="浅色"
                                     Checked="Theme_Changed" Margin="0,0,18,0"/>
                        <RadioButton x:Name="DarkThemeRadio" Content="深色"
                                     Checked="Theme_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 窗口背景效果卡片 -->
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ColorBackground20" FontSize="17" Margin="0,0,7,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="窗口背景效果" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="1,12,0,0">
                        <RadioButton x:Name="MicaRadio" Content="Mica（云母）"
                                     Checked="Backdrop_Changed" Margin="0,0,18,0"/>
                        <RadioButton x:Name="AcrylicRadio" Content="Acrylic（毛玻璃）"
                                     Checked="Backdrop_Changed" Margin="0,0,18,0"/>
                        <RadioButton x:Name="SolidRadio" Content="纯色"
                                     Checked="Backdrop_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 自定义背景图 -->
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Image20" FontSize="17" Margin="0,0,7,0"
                                       Foreground="{DynamicResource ZiporaTextSecondary}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="自定义背景" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="BackgroundImagePathBox" Grid.Column="0" IsReadOnly="True"
                                    PlaceholderText="未选择图片" ToolTip="当前使用的背景图片路径"/>
                        <ui:Button Grid.Column="1" Content="选择图片…" Margin="8,0,0,0"
                                   Style="{StaticResource DialogSecondaryButton}"
                                   Click="ChooseBackgroundImage_Click"/>
                        <ui:Button x:Name="ClearBackgroundImageButton" Grid.Column="2" Content="清除" Margin="8,0,0,0"
                                   Style="{StaticResource DialogSecondaryButton}"
                                   Click="ClearBackgroundImage_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 功能分类 -->
            <Grid x:Name="FunctionSection" Margin="2,4,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Settings20" FontSize="17" Margin="0,0,7,0"
                                   Foreground="{DynamicResource ZiporaAccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="功能" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="1" Height="1" Margin="14,0,0,0"
                        Background="{DynamicResource ZiporaCardBorder}" VerticalAlignment="Center"/>
            </Grid>

            <!-- 压缩炸弹防护 -->
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Shield20" FontSize="17" Margin="0,0,7,0"
                                       Foreground="{DynamicResource ZiporaTextSecondary}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="压缩炸弹防护" FontWeight="SemiBold" VerticalAlignment="Center"/>
<Border Margin="8,0,0,0" Width="20" Height="20" Background="Transparent"
                          VerticalAlignment="Center" Cursor="Help" Focusable="True"
                          AutomationProperties.Name="压缩炸弹防护说明"
                          ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="30000">
                        <Border.ToolTip>
                            <ToolTip Padding="12,9"><TextBlock Text="打开压缩包时检查异常膨胀；所选内容解压或拖出时检查并监控磁盘剩余空间。"
                               TextWrapping="Wrap" Style="{StaticResource SecondaryText}" MaxWidth="300" FontSize="12"
                              /></ToolTip>
                        </Border.ToolTip>
                        <ui:SymbolIcon Symbol="Info20" FontSize="14"
                                       Foreground="{DynamicResource ZiporaTextSecondary}" VerticalAlignment="Center"/>
                    </Border>
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="ArchiveBombProtectionBox" Margin="0,10,0,0"
                                     Checked="ArchiveBombProtection_Changed"
                                     Unchecked="ArchiveBombProtection_Changed">
                        <ui:ToggleSwitch.OffContent>
                            <TextBlock Text="启用压缩炸弹防护"/>
                        </ui:ToggleSwitch.OffContent>
                        <ui:ToggleSwitch.OnContent>
                            <TextBlock Text="启用压缩炸弹防护"/>
                        </ui:ToggleSwitch.OnContent>
                    </ui:ToggleSwitch>
                </StackPanel>
            </Border>

            <!-- 系统集成卡片 -->
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="WindowApps20" FontSize="17" Margin="0,0,7,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="系统右键菜单" FontWeight="SemiBold" VerticalAlignment="Center"/>
<Border Margin="8,0,0,0" Width="20" Height="20" Background="Transparent"
                          VerticalAlignment="Center" Cursor="Help" Focusable="True"
                          AutomationProperties.Name="系统右键菜单说明"
                          ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="30000">
                        <Border.ToolTip>
                            <ToolTip Padding="12,9"><TextBlock Text="开启后，在资源管理器中右键压缩包会出现「用 Zipora 解压」子菜单。Windows 11 需点击「显示更多选项」查看。"
                               TextWrapping="Wrap" Style="{StaticResource SecondaryText}" MaxWidth="300" FontSize="12"
                              /></ToolTip>
                        </Border.ToolTip>
                        <ui:SymbolIcon Symbol="Info20" FontSize="14"
                                       Foreground="{DynamicResource ZiporaTextSecondary}" VerticalAlignment="Center"/>
                    </Border>
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="ContextMenuBox" Margin="0,10,0,0"
                                     Checked="ContextMenuBox_Changed" Unchecked="ContextMenuBox_Changed">
                        <ui:ToggleSwitch.OffContent>
                            <TextBlock Text="在系统右键菜单中集成 Zipora"/>
                        </ui:ToggleSwitch.OffContent>
                        <ui:ToggleSwitch.OnContent>
                            <TextBlock Text="在系统右键菜单中集成 Zipora"/>
                        </ui:ToggleSwitch.OnContent>
                    </ui:ToggleSwitch>
                    <Border x:Name="OpStatusPanel" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="6" Padding="10,7" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="OpStatusIcon" Symbol="CheckmarkCircle20" FontSize="15"
                                           Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OpStatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 常用密码管理卡片 -->
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Key20" FontSize="17" Margin="0,0,7,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="密码管理" FontWeight="SemiBold" VerticalAlignment="Center"/>
<Border Margin="8,0,0,0" Width="20" Height="20" Background="Transparent"
                          VerticalAlignment="Center" Cursor="Help" Focusable="True"
                          AutomationProperties.Name="密码管理说明"
                          ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="30000">
                        <Border.ToolTip>
                            <ToolTip Padding="12,9"><TextBlock x:Name="PasswordStorageText" Text="保存最多 10 个常用密码，在解压或新建压缩包时可快速填入。列表显示完整密码，本地存储使用当前 Windows 用户加密保护。"
                               TextWrapping="Wrap" Style="{StaticResource SecondaryText}" MaxWidth="300" FontSize="12"
                              /></ToolTip>
                        </Border.ToolTip>
                        <ui:SymbolIcon Symbol="Info20" FontSize="14"
                                       Foreground="{DynamicResource ZiporaTextSecondary}" VerticalAlignment="Center"/>
                    </Border>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="管理密码…" Style="{StaticResource DialogSecondaryButton}"
                               Width="112" Height="34" Padding="12,0" Margin="12,0,0,0"
                               VerticalAlignment="Center" Click="ManagePasswords_Click"/>
                </Grid>
            </Border>
            <!-- 密码上传设置卡片 -->
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CloudArrowUp20" FontSize="17" Margin="0,0,7,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="密码上传" FontWeight="SemiBold" VerticalAlignment="Center"/>
<Border Margin="8,0,0,0" Width="20" Height="20" Background="Transparent"
                          VerticalAlignment="Center" Cursor="Help" Focusable="True"
                          AutomationProperties.Name="密码上传说明"
                          ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="30000">
                        <Border.ToolTip>
                            <ToolTip Padding="12,9"><TextBlock Text="把密码匿名贡献到云端密码库，供他人查询。关闭后仅影响自动上传，手动查询不受影响。"
                               TextWrapping="Wrap" Style="{StaticResource SecondaryText}" MaxWidth="300" FontSize="12"
                              /></ToolTip>
                        </Border.ToolTip>
                        <ui:SymbolIcon Symbol="Info20" FontSize="14"
                                       Foreground="{DynamicResource ZiporaTextSecondary}" VerticalAlignment="Center"/>
                    </Border>
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="ExtractUploadBox" Margin="0,10,0,0"
                                     Checked="Contribute_Changed" Unchecked="Contribute_Changed">
                        <ui:ToggleSwitch.OffContent>
                            <TextBlock Text="解压后上传密码（手动/破解/云端验证成功时自动贡献）" TextWrapping="Wrap"/>
                        </ui:ToggleSwitch.OffContent>
                        <ui:ToggleSwitch.OnContent>
                            <TextBlock Text="解压后上传密码（手动/破解/云端验证成功时自动贡献）" TextWrapping="Wrap"/>
                        </ui:ToggleSwitch.OnContent>
                    </ui:ToggleSwitch>
                    <ui:ToggleSwitch x:Name="CompressUploadBox" Margin="0,8,0,0"
                                     Checked="Contribute_Changed" Unchecked="Contribute_Changed">
                        <ui:ToggleSwitch.OffContent>
                            <TextBlock Text="压缩后上传密码（新建压缩包设密码后自动贡献）" TextWrapping="Wrap"/>
                        </ui:ToggleSwitch.OffContent>
                        <ui:ToggleSwitch.OnContent>
                            <TextBlock Text="压缩后上传密码（新建压缩包设密码后自动贡献）" TextWrapping="Wrap"/>
                        </ui:ToggleSwitch.OnContent>
                    </ui:ToggleSwitch>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync20" FontSize="17" Margin="0,0,7,0"
                                       Foreground="{DynamicResource ZiporaTextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="软件更新" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="UpdateFrequencyBox" Height="36" VerticalContentAlignment="Center"
                                  SelectionChanged="UpdateFrequency_Changed" SelectedIndex="-1">
                            <ComboBoxItem Content="每次"/><ComboBoxItem Content="每天"/><ComboBoxItem Content="每周"/>
                            <ComboBoxItem Content="每2周"/><ComboBoxItem Content="每月"/><ComboBoxItem Content="永不"/>
                        </ComboBox>
                        <ui:Button x:Name="CheckUpdatesButton" Grid.Column="2" Height="36" Padding="12,0"
                                   Content="立即检查" Click="CheckUpdates_Click" HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- 操作区固定在窗口底部，长设置页滚动时仍可随时关闭。 -->
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,4">
            <ui:Button Content="关闭" Style="{StaticResource DialogSecondaryButton}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
