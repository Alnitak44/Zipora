<ui:FluentWindow x:Class="Zipora.Dialogs.DictionaryCrackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="字典密码破解"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ZiporaWindowSurface}"
        WindowCornerPreference="Round"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="字典密码破解" ShowMaximize="False" ShowMinimize="False"
                     FontSize="16" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1" Margin="0,8,0,0">

            <!-- 说明 + 输入 -->
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <ui:SymbolIcon Symbol="Key20" FontSize="18" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="逐行测试字典中的密码" Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="压缩包" Style="{StaticResource FieldLabel}" Margin="1,10,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="ArchiveBox" Grid.Column="0" IsReadOnly="True"
                                    ToolTip="要破解的加密压缩包"/>
                        <ui:Button x:Name="PickArchiveButton" Grid.Column="1" Margin="8,0,0,0"
                                   Style="{StaticResource DialogSecondaryButton}"
                                   Click="PickArchive_Click" Content="选择…"/>
                    </Grid>

                    <TextBlock Text="字典文件" Style="{StaticResource FieldLabel}" Margin="1,10,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="DictBox" Grid.Column="0"
                                  SelectionChanged="DictBox_SelectionChanged"
                                  ToolTip="展开选择内置字典（程序目录 dictionaries\ 下），或浏览其他文件">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ui:Button x:Name="RefreshDictButton" Grid.Column="1" Margin="8,0,0,0"
                                   Style="{StaticResource DialogSecondaryButton}"
                                   Click="RefreshDict_Click" Content="刷新"
                                   ToolTip="重新扫描内置字典目录"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="线程数" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Style="{StaticResource SecondaryText}"/>
                        <ComboBox x:Name="ThreadBox" Grid.Column="1" Width="72" VerticalAlignment="Center">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="4" IsSelected="True"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="12"/>
                            <ComboBoxItem Content="16"/>
                        </ComboBox>
                        <ui:Button x:Name="StartButton" Grid.Column="2" Margin="16,0,0,0"
                                   Style="{StaticResource DialogPrimaryButton}"
                                   Click="Start_Click" Content="开始破解"/>
                        <ui:Button x:Name="StopButton" Grid.Column="3" Margin="8,0,0,0" HorizontalAlignment="Left"
                                   Style="{StaticResource DialogSecondaryButton}"
                                   Click="Stop_Click" Content="停止" IsEnabled="False"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 进度卡片 -->
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FlashCheckmark20" FontSize="17" Margin="0,0,7,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="破解进度" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,8"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                               Style="{StaticResource SecondaryText}"
                               Text="请选择压缩包和字典文件后开始。"/>
                </StackPanel>
            </Border>

            <!-- 结果卡片 -->
            <Border Style="{StaticResource OverlayCard}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="破解结果" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,6,0,10"
                               Style="{StaticResource SecondaryText}" Text="尚未开始。"/>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="CopyButton" Style="{StaticResource DialogSecondaryButton}"
                                   Click="Copy_Click" Content="复制密码" IsEnabled="False"/>
                        <ui:Button x:Name="UseButton" Style="{StaticResource DialogPrimaryButton}"
                                   Click="Use_Click" Content="用此密码解压" IsEnabled="False"/>
                        <ui:Button Content="关闭" Style="{StaticResource DialogSecondaryButton}"
                                   IsCancel="True" Margin="16,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
