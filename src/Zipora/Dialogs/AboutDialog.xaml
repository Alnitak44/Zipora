<ui:FluentWindow x:Class="Zipora.Dialogs.AboutDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="关于 Zipora" Icon="pack://application:,,,/Assets/Zipora.png" Width="540" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" Background="{DynamicResource ZiporaWindowSurface}" WindowCornerPreference="Round" FontFamily="Microsoft YaHei UI" FontSize="13">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="关于 Zipora" ShowMaximize="False" ShowMinimize="False" FontSize="16" FontWeight="SemiBold" />
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="24" Margin="0,8,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Width="60" Height="60" CornerRadius="14" ClipToBounds="True" Margin="0,0,16,0" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/Zipora.png" Stretch="UniformToFill" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Zipora" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource ZiporaTextPrimary}" />
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
              <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2">
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="White" />
              </Border>
              <TextBlock Text="轻盈的压缩包浏览与解压工具" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ZiporaTextSecondary}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <TextBlock Margin="0,20,0,16" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource ZiporaTextSecondary}">基于官方 7-Zip 引擎，支持查看、解压、创建、分卷、完整性校验与本地字典破解。</TextBlock>
        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="14,4">
          <StackPanel>
            <Grid Margin="0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="126" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Grid.Column="0" Symbol="Archive20" FontSize="17" Foreground="{DynamicResource ZiporaTextSecondary}" />
              <TextBlock Grid.Column="1" Text="压缩引擎" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="官方 7-Zip（7z.exe / 7z.dll）" Foreground="{DynamicResource ZiporaTextSecondary}" />
            </Grid>
            <Separator Margin="0,3" />
            <Separator Margin="0,3" />
            <Grid Margin="0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="126" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Grid.Column="0" Symbol="Info20" FontSize="17" Foreground="{DynamicResource ZiporaTextSecondary}" />
              <TextBlock Grid.Column="1" Text="隐私说明" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="离线处理文件与密码，不自动上传任何内容。" TextWrapping="Wrap" Foreground="{DynamicResource ZiporaTextSecondary}" />
            </Grid>
          </StackPanel>
        </Border>
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:Button Grid.Column="0" Appearance="Secondary" Padding="11,6" Click="License_Click" ToolTip="打开随程序附带的 7-Zip 许可证文件">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Info20" FontSize="16" Margin="0,0,6,0" />
              <TextBlock Text="查看 7-Zip 许可证" />
            </StackPanel>
          </ui:Button>
          <ui:Button Grid.Column="2" Content="关闭" IsCancel="True" Style="{StaticResource DialogSecondaryButton}" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>