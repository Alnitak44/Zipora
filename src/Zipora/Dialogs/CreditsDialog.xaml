<ui:FluentWindow x:Class="Zipora.Dialogs.CreditsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="鸣谢"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ZiporaWindowSurface}"
        WindowCornerPreference="Round"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="鸣谢" ShowMaximize="False" ShowMinimize="False"
                     FontSize="16" FontWeight="SemiBold"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,8,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="HatGraduation20" FontSize="22" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    <TextBlock Text="鸣谢" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="感谢以下项目的作者" Margin="0,6,0,14"
                           Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>

                <!-- 每个项目一行卡片 -->
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6"
                        Padding="12,8" Margin="0,0,0,6">
                    <TextBlock FontSize="14">
                        <Hyperlink NavigateUri="https://www.7-zip.org/"
                                   RequestNavigate="Hyperlink_RequestNavigate">7-Zip</Hyperlink>
                    </TextBlock>
                </Border>
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6"
                        Padding="12,8" Margin="0,0,0,6">
                    <TextBlock FontSize="14">
                        <Hyperlink NavigateUri="https://github.com/hillghost86/7zrpw"
                                   RequestNavigate="Hyperlink_RequestNavigate">7zrpw</Hyperlink>
                    </TextBlock>
                </Border>
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6"
                        Padding="12,8" Margin="0,0,0,6">
                    <TextBlock FontSize="14">
                        <Hyperlink NavigateUri="https://github.com/microsoft/fluentui-system-icons"
                                   RequestNavigate="Hyperlink_RequestNavigate">Fluent System Icons</Hyperlink>
                    </TextBlock>
                </Border>
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6"
                        Padding="12,8" Margin="0,0,0,14">
                    <TextBlock FontSize="14">
                        <Hyperlink NavigateUri="https://KeyFetch.site"
                                   RequestNavigate="Hyperlink_RequestNavigate">KeyFetch</Hyperlink>
                    </TextBlock>
                </Border>

                <ui:Button Content="关闭" IsCancel="True" HorizontalAlignment="Center"
                           Style="{StaticResource DialogSecondaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
