<ui:FluentWindow x:Class="Zipora.Dialogs.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:behaviors="clr-namespace:Zipora.Behaviors"
    Title="发现新版本" Icon="pack://application:,,,/Zipora;component/Assets/Zipora.png"
    Width="620" Height="620" MinWidth="0" MinHeight="0" SizeToContent="Manual"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True" Background="{DynamicResource ZiporaWindowSurface}"
    WindowCornerPreference="Round" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Title="发现新版本" ShowMaximize="False" ShowMinimize="False" FontSize="16" FontWeight="SemiBold"/>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,8,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="ArrowSync20" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Foreground="{DynamicResource ZiporaAccentBrush}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="VersionText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CurrentVersionText" Margin="0,5,0,0" Foreground="{DynamicResource ZiporaTextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="更新日志" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <FlowDocumentScrollViewer x:Name="NotesViewer" Grid.Row="1" IsToolBarVisible="False" IsSelectionEnabled="True"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    behaviors:AutoHideScrollBars.Enabled="True" BorderThickness="0" Padding="0"
                    Background="Transparent" Foreground="{DynamicResource ZiporaTextPrimary}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="UpgradeHint" Grid.ColumnSpan="3" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource ZiporaTextSecondary}" Margin="0,0,0,10"/>
            <ui:Button Grid.Row="1" Appearance="Transparent" Content="发行说明" HorizontalAlignment="Left" Padding="0,5" Click="ReleasePage_Click"/>
            <ui:Button Grid.Row="1" Grid.Column="1" Content="稍后" Width="88" Height="34" Margin="8,0,8,0" IsCancel="True"/>
            <ui:Button x:Name="DownloadButton" Grid.Row="1" Grid.Column="2" Content="前往下载" Appearance="Primary"
                       Width="110" Height="34" IsDefault="True" Click="Download_Click"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
