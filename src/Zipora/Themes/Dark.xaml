<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Zipora 深色主题（语义色板）
         与 Light.xaml 键完全一致，值按深色视觉调整，
         控件通过 DynamicResource 自动跟随。
         ============================================================ -->

    <!-- 窗口 / 卡片 -->
    <SolidColorBrush x:Key="ZiporaWindowBackground" Color="#202020"/>
    <!-- 半透明窗口底色：保留系统 Acrylic/Mica 的透出，同时避免窗口根容器回退成白色。 -->
    <SolidColorBrush x:Key="ZiporaWindowSurface" Color="#66202020"/>
    <SolidColorBrush x:Key="ZiporaCardBackground" Color="#26292E"/>
    <SolidColorBrush x:Key="ZiporaCardBorder" Color="#3A3D42"/>
    <SolidColorBrush x:Key="ZiporaOverlayBackground" Color="#2B2E33"/>
    <SolidColorBrush x:Key="ZiporaContentBackground" Color="#242830"/>
    <SolidColorBrush x:Key="ZiporaToolbarBackground" Color="#292E37"/>
    <SolidColorBrush x:Key="ZiporaSidebarBackground" Color="#20242C"/>
    <SolidColorBrush x:Key="ZiporaBreadcrumbBackground" Color="#272C34"/>
    <SolidColorBrush x:Key="ZiporaDividerBrush" Color="#363D48"/>
    <SolidColorBrush x:Key="ZiporaFlyoutBackground" Color="#2B3039"/>
    <SolidColorBrush x:Key="ZiporaEmptyBadgeBackground" Color="#303B4B"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="ZiporaTextPrimary" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="ZiporaTextSecondary" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="ZiporaTextTertiary" Color="#787878"/>

    <!-- 交互反馈 -->
    <SolidColorBrush x:Key="ZiporaHoverBackground" Color="#34373C"/>
    <SolidColorBrush x:Key="ZiporaSelectedBackground" Color="#3A4A5E"/>
    <SolidColorBrush x:Key="ZiporaAccentBrush" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="ZiporaAccentText" Color="#4CC2FF"/>

    <!-- 列表行（悬浮/选中圆角胶囊） -->
    <SolidColorBrush x:Key="ZiporaRowHoverFill" Color="#124CC2FF"/>
    <SolidColorBrush x:Key="ZiporaRowSelectedFill" Color="#264CC2FF"/>
    <SolidColorBrush x:Key="ZiporaRowSelectedStroke" Color="#994CC2FF"/>
    <SolidColorBrush x:Key="ZiporaRowInactiveFill" Color="#124CC2FF"/>
    <SolidColorBrush x:Key="ZiporaRowInactiveStroke" Color="#804CC2FF"/>
    <SolidColorBrush x:Key="ZiporaRowSelectedHoverFill" Color="#3C4CC2FF"/>

    <!-- 状态文字 -->
    <SolidColorBrush x:Key="ZiporaWarningBrush" Color="#FF8A80"/>
    <SolidColorBrush x:Key="ZiporaSuccessBrush" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="ZiporaMutedBrush" Color="#9D9D9D"/>

    <!-- 骨架屏：底色 + 流光画刷。主题切换时整体替换画刷，避免 Freezable 上的动态颜色引用。 -->
    <SolidColorBrush x:Key="ZiporaSkeletonBase" Color="#2E3136"/>
    <LinearGradientBrush x:Key="ZiporaSkeletonShimmerBrush" MappingMode="Absolute"
                         StartPoint="0,0" EndPoint="200,0" SpreadMethod="Repeat">
        <GradientStop Offset="0" Color="#00FFFFFF"/>
        <GradientStop Offset="0.4" Color="#33FFFFFF"/>
        <GradientStop Offset="0.6" Color="#33FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
        <LinearGradientBrush.Transform>
            <MatrixTransform Matrix="0.025,0,0,0.025,0,0"/>
        </LinearGradientBrush.Transform>
    </LinearGradientBrush>

</ResourceDictionary>
