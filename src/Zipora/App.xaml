<Application x:Class="Zipora.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI 的基础主题必须在控件字典之前加载；ThemeManager 会在运行时替换它。 -->
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
                <!-- 自建语义色板（Light/Dark）由 ThemeManager 运行时插入。 -->
                <ResourceDictionary Source="Themes/Zipora.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 对话框主按钮：WPF-UI 外观（Primary 填充） -->
            <Style x:Key="DialogPrimaryButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Primary"/>
                <Setter Property="MinWidth" Value="96"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>

            <!-- 对话框次按钮 -->
            <Style x:Key="DialogSecondaryButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Secondary"/>
                <Setter Property="MinWidth" Value="96"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
